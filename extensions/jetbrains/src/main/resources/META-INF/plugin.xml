<idea-plugin>
    <id>com.rewind.ide</id>
    <name>Rewind IDE</name>
    <vendor email="rewind@example.com" url="https://github.com/habeldavidson007-glitch/rewind">Rewind</vendor>

    <description><![CDATA[
        Record, replay, and recall your IDE activity with AI-powered memory.
        Tracks file edits, terminal commands, git operations, builds, tests,
        and AI assistant interactions across all JetBrains IDEs.
        <br/><br/>
        Works with: IntelliJ IDEA, GoLand, PyCharm, WebStorm, Android Studio
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="rewind-withGit.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.rewind.RecorderService"/>
        <statusBarWidgetFactory implementation="com.rewind.RewindStatusBarFactory"/>
        <applicationConfigurable parentId="tools" instance="com.rewind.RewindConfigurable"/>
        <notificationGroup id="Rewind Notifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Rewind.ToggleRecording"
                class="com.rewind.actions.ToggleRecordingAction"
                text="Toggle Recording"
                description="Enable/disable Rewind activity recording">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Rewind.ShowStatus"
                class="com.rewind.actions.ShowStatusAction"
                text="Show Recording Status"
                description="Display current Rewind recording status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Rewind.SearchHistory"
                class="com.rewind.actions.SearchHistoryAction"
                text="Search Shell History"
                description="Search across IDE and shell history">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>